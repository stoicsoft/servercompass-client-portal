{
  "name": "servercompass-client-portal",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hosted, capability-scoped client portal runtime for Server Compass",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:runtime": "npm ci --prefix packages/client-portal-runtime",
    "test": "npm run test:manifest && npm --prefix packages/client-portal-runtime test",
    "test:manifest": "node scripts/validate-runtime-release.mjs",
    "manifest:keygen": "node scripts/generate-manifest-keypair.mjs",
    "manifest:sign": "node scripts/sign-runtime-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoicsoft/servercompass-client-portal.git"
  }
}
